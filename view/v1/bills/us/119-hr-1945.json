{"v":1,"built_at":"2026-10-07T06:34:20.589Z","core":{"appSha":"23c7207e5fd0","builtAt":"2026-10-04T20:54:20.650Z","schemaV":1},"key":"us/119-hr-1945","model":{"found":true,"billKey":"us/119-hr-1945","polity":"us","eyebrow":"United States","reference":"H.R. 1945","title":"America's National Churchill Museum National Historic Landmark Act","titleExpandable":false,"meta":"Natural Resources Committee · Rep. Robert Onder (R-MO)","summary":{"lead":"Summary: ","text":"The bill would designate the America's National Churchill Museum at Westminster College in Fulton, Missouri as a National Historic Landmark, honoring the site where British Prime Minister Winston Churchill delivered his famous 1946 \"Iron Curtain Speech.\" It would allow the Department of the Interior to partner with public and private organizations to protect the site, provide educational programs, and offer technical and financial support. The bill also directs Interior to study whether the museum should become part of the National Park System and to examine other preservation options.","aiTag":"[AI-Generated]"},"pathLabel":"The legislative path","latest":{"labelText":"Passed Senate (unanimous consent)","glyph":{"icon":"capitol","badge":true},"date":"29 September 2026"},"asOf":{"lead":"Record as of ","date":"29 September 2026","note":"the most recent action in the official record. Status can lag; each step below carries its own date."},"groups":[{"spine":{"key":"rec-H.R. 1945-16","kind":"record","spine":true,"date":"29 September 2026","labelText":"Passed Senate (unanimous consent)","glyph":{"icon":"capitol","badge":true},"postId":"us-20260930-75c701fc","postHref":"/p/us-20260930-75c701fc","whatsNext":{"lead":"What's next: ","text":"Presidential review (±10 days)"}},"isTip":true,"hidden":[{"key":"rec-H.R. 1945-15","kind":"record","spine":false,"date":"4 March 2026","labelText":"Received in the Senate, read twice."}],"moreLabel":"1 more action","hideLabel":"Hide","a11yShow":"Show 1 more recorded actions","a11