{"v":1,"built_at":"2026-10-27T20:16:44.192Z","core":{"appSha":"914721900fba","builtAt":"2026-10-26T00:15:24.843Z","schemaV":1},"key":"us/119-hr-8352","model":{"found":true,"billKey":"us/119-hr-8352","polity":"us","eyebrow":"United States","reference":"H.R. 8352","title":"Criminal History Access Act of 2026","titleExpandable":false,"meta":"Judiciary Committee · Rep. Derek Schmidt (R-KS)","summary":{"lead":"Official summary (Congressional Research Service, Reported to House): ","blocks":[{"kind":"para","text":"Criminal History Access Act of 2026","gap":"none"},{"kind":"para","text":"This bill authorizes a new type of entity—peace officer standards and training agencies—to access criminal history record information maintained by the Federal Bureau of Investigation. The term peace officer standards and training agency means an agency of a state, the District of Columbia, or a U.S. territory that is authorized to set standards for the hiring, training, ethical conduct, and retention of its law enforcement officers through certification, licensing, or other similar qualification processes.","gap":"para"}]},"pathLabel":"The legislative path","latest":{"labelText":"Passed Senate (unanimous consent)","glyph":{"icon":"capitol","badge":true},"date":"30 September 2026"},"asOf":{"lead":"Record as of ","date":"14 October 2026","note":"the most recent action in the official record. Status can lag; each step below carries its own date."},"groups":[{"spine":{"key":"rec-H.R. 8352-16","kind":"record","spine":false,"date":"14 October 2026","labelText":"Message on Senate action sent to the House."},"isTip":false,"hidden":[],"moreLabel":"0 more actions","hideLabel":"Hide","a11yShow":"Show 0 more recorded actions","a11yHide":"Hide 0 more recorded actions"},{"spine":{"key":"rec-H.R. 8352-14","kind":"record","spine":true,"date":"30 September 2026","labelText":"Passed Senate (unanimous consent)","glyph":{"icon":"capitol","badge":true},"postId":"us-20261001-93f070be","postHref":"/p/us-2026100